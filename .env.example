# Copy to .env and fill in values privately. Process environment takes precedence.
SERVICE_ROLE=moderator
SUBMISSIONS_DB=tumbleweed_submissions
APPROVED_DB=tumbleweed
SUBMISSIONS_MONGODB_URI=
APPROVED_READ_MONGODB_URI=
# Moderator process only. Never supply this secret to SERVICE_ROLE=public.
APPROVED_WRITE_MONGODB_URI=
# Leave empty for same-origin hosting; otherwise list exact frontend origins.
ALLOWED_ORIGINS=
